rules_version = '2';
service cloud.firestore {
  match /databases/{db}/documents {

    function signedIn() { return request.auth != null; }
    function userDoc() { return /databases/$(db)/documents/users/$(request.auth.uid); }
    function role() {
      return signedIn() && exists(userDoc()) ? get(userDoc()).data.role : 'none';
    }
    function isBph()    { return role() == 'bph'; }
    function isMember() { return role() in ['anggota', 'bph']; }
    function onlyChanges(keys) {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly(keys);
    }
    function httpUrl(u) { return u is string && u.size() <= 500 && u.matches('^https?://.+'); }
    function sess(sid) { return get(/databases/$(db)/documents/attendance_sessions/$(sid)).data; }

    /* ---------- Akun ---------- */
    match /users/{uid} {
      allow get:  if signedIn() && (request.auth.uid == uid || isBph());
      allow list: if isBph();
      allow create: if signedIn()
        && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['uid','email','displayName','role','createdAt'])
        && request.resource.data.uid == uid
        && request.resource.data.email == request.auth.token.email
        && request.resource.data.role == 'pending'
        && request.resource.data.createdAt == request.time;
      allow update: if signedIn() && request.auth.uid == uid && onlyChanges(['displayName','bio'])
        && request.resource.data.displayName is string && request.resource.data.displayName.size() <= 80
        && (!('bio' in request.resource.data) || request.resource.data.bio.size() <= 300);
      allow update: if isBph() && request.auth.uid != uid
        && onlyChanges(['role','verifiedAt','verifiedBy'])
        && request.resource.data.role in ['pending','anggota','bph','rejected'];
      allow delete: if false;
    }

    /* ---------- Konten publik (BPH menulis) ---------- */
    match /publications/{id}       { allow read: if true; allow create, update, delete: if isBph(); }
    match /publication_covers/{id} { allow read: if true; allow create, update, delete: if isBph(); }
    match /timeline/{id}           { allow read: if true; allow create, update, delete: if isBph(); }
    match /pengurus/{id}           { allow read: if true; allow create, update, delete: if isBph(); }
    match /kegiatan/{id}           { allow read: if true; allow create, update, delete: if isBph(); }
    match /prestasi/{id}           { allow read: if true; allow create, update, delete: if isBph(); }
    match /galeri/{id}             { allow read: if true; allow create, update, delete: if isBph(); }

    /* ---------- Khusus anggota (BPH menulis) ---------- */
    match /karya_ilmiah/{id} { allow read: if isMember(); allow create, update, delete: if isBph(); }
    match /materi_larut/{id} { allow read: if isMember(); allow create, update, delete: if isBph(); }
    match /pengumuman/{id}   { allow read: if isMember(); allow create, update, delete: if isBph(); }
    match /settings/{id}     { allow read: if isMember(); allow create, update, delete: if isBph(); }

    /* ---------- Pengajuan karya oleh anggota ---------- */
    match /submissions/{id} {
      allow read: if signedIn() && (resource.data.uid == request.auth.uid || isBph());
      allow create: if isMember()
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.keys().hasOnly(['uid','authorName','title','category','bidang','fileUrl','note','status','createdAt'])
        && request.resource.data.status == 'diajukan'
        && request.resource.data.createdAt == request.time
        && request.resource.data.title is string && request.resource.data.title.size() <= 200
        && request.resource.data.note.size() <= 500
        && httpUrl(request.resource.data.fileUrl);
      allow update: if (isBph()
          && onlyChanges(['status','feedback','reviewedBy','reviewedAt'])
          && request.resource.data.status in ['diajukan','revisi','disetujui','ditolak'])
        || (signedIn() && resource.data.uid == request.auth.uid
          && resource.data.status in ['diajukan','revisi']
          && onlyChanges(['title','category','bidang','fileUrl','note','status','updatedAt'])
          && request.resource.data.status == 'diajukan'
          && request.resource.data.title.size() <= 200
          && request.resource.data.note.size() <= 500
          && httpUrl(request.resource.data.fileUrl));
      allow delete: if isBph() || (signedIn() && resource.data.uid == request.auth.uid
          && resource.data.status in ['diajukan','revisi']);
    }

    /* ---------- Pendaftaran kegiatan/OPREC (publik menulis, 1 email per kegiatan) ---------- */
    match /registrations/{recId} {
      allow read: if isBph();
      allow create: if request.resource.data.keys().hasOnly(['event','eventTitle','name','email','phone','school','note','createdAt'])
        && recId == request.resource.data.event + '_' + request.resource.data.email.lower()
        && request.resource.data.email.matches('^[^/\\s@]+@[^/\\s@]+\\.[^/\\s@]+$')
        && request.resource.data.email.size() <= 100
        && request.resource.data.name is string && request.resource.data.name.size() >= 2 && request.resource.data.name.size() <= 80
        && request.resource.data.phone.size() <= 20
        && request.resource.data.school.size() <= 80
        && request.resource.data.note.size() <= 300
        && request.resource.data.eventTitle.size() <= 120
        && request.resource.data.createdAt == request.time
        && exists(/databases/$(db)/documents/kegiatan/$(request.resource.data.event))
        && get(/databases/$(db)/documents/kegiatan/$(request.resource.data.event)).data.registerOpen == true;
      allow update: if false;
      allow delete: if isBph();
    }

    /* ---------- URL pendek ---------- */
    match /shortlinks/{slug} {
      allow get: if true;
      allow list: if isBph();
      allow create, delete: if isBph();
      allow update: if isBph()
        || (onlyChanges(['clicks']) && request.resource.data.clicks == resource.data.clicks + 1);
    }

    /* ---------- Presensi ---------- */
    match /attendance_sessions/{sid} { allow read, write: if isBph(); }

    match /attendance/{recId} {
      allow read: if isBph() || (signedIn() && resource.data.uid == request.auth.uid);
      allow create: if isMember()
        && recId == request.resource.data.sessionId + '_' + request.auth.uid
        && request.resource.data.keys().hasOnly(['sessionId','uid','title','token','scannedAt'])
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.scannedAt == request.time
        && exists(/databases/$(db)/documents/attendance_sessions/$(request.resource.data.sessionId))
        && sess(request.resource.data.sessionId).active == true
        && sess(request.resource.data.sessionId).token == request.resource.data.token
        && sess(request.resource.data.sessionId).title == request.resource.data.title
        && request.time < sess(request.resource.data.sessionId).expiresAt;
      allow update: if false;
      allow delete: if isBph();
    }

    match /{document=**} { allow read, write: if false; }
  }
}
